# ---------------------------------------------------------------------------
# Bible Verses Understood — environment variables
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Supabase (client-side, safe to expose) --------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# The anon key is designed by Supabase to be public; Row Level Security is what
# protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional client flags -------------------------------------------------
# Overrides the Edge Function base URL. Defaults to
# `${VITE_SUPABASE_URL}/functions/v1`. Set this when running
# `supabase functions serve` locally (e.g. http://127.0.0.1:54321/functions/v1).
VITE_FUNCTIONS_URL=

# Google Analytics 4 measurement ID. Only needed to override the property that
# index.html already configures (G-YT6WK8YMX9).
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set these as Supabase Edge Function secrets, never here
# with a VITE_ prefix, or they will be bundled into the browser build.
#   supabase secrets set --env-file supabase/functions/.env
# ---------------------------------------------------------------------------

# Google Generative Language (Gemini) API key. Powers every explanation,
# devotional and follow-up answer. Required for commentary features.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model used for commentary (defaults to
# gemini-2.0-flash).
GEMINI_MODEL=

# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected into Edge Functions by Supabase automatically. You do not set them
# here, and `supabase secrets set` rejects the reserved SUPABASE_ prefix. The
# service role key is used only inside a function, to write the shared study
# cache — it must never reach the browser.

# --- Optional licensed Scripture providers ---------------------------------
# Without these the app serves its bundled public-domain translations
# (KJV, ASV, YLT, BSB). Adding credentials unlocks the copyrighted
# translations that the provider is licensed to serve.

# API.Bible (https://scripture.api.bible) — unlocks translations your key is
# authorised for, e.g. NASB/CSB/AMP depending on your agreement.
API_BIBLE_KEY=

# Crossway ESV API (https://api.esv.org) — unlocks ESV.
ESV_API_KEY=
