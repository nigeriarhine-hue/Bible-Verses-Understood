# ---------------------------------------------------------------------------
# Bible Verses Understood — environment variables
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Supabase (client-side, safe to expose) --------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# The anon key is designed by Supabase to be public; Row Level Security is what
# protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional client flags -------------------------------------------------
# Overrides the Edge Function base URL. Defaults to
# `${VITE_SUPABASE_URL}/functions/v1`. Set this when running
# `supabase functions serve` locally (e.g. http://127.0.0.1:54321/functions/v1).
VITE_FUNCTIONS_URL=

# The site's public origin, used for canonical URLs, Open Graph tags and share
# links. Set this in the Production environment only, so preview deployments and
# local development keep using their own origin.
#   VITE_SITE_URL=https://bible-verses-understood.vercel.app
VITE_SITE_URL=

# Google Analytics 4 measurement ID. Only needed to override the property that
# index.html already configures (G-YT6WK8YMX9).
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set these as Supabase Edge Function secrets, never here
# with a VITE_ prefix, or they will be bundled into the browser build.
#   supabase secrets set --env-file supabase/functions/.env
# ---------------------------------------------------------------------------

# Google Generative Language (Gemini) API key. Powers every explanation,
# devotional and follow-up answer. Required for commentary features.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model used for commentary (defaults to
# gemini-3.6-flash).
GEMINI_MODEL=
# Optional: a second model to try once, and only when the model above answers
# HTTP 503 / UNAVAILABLE because it is overloaded. Pick something lighter or
# older than your primary so it is not queueing behind the same demand, and
# confirm the name is real for your key first:
#   npm run gemini:models -- --check <model>
GEMINI_FALLBACK_MODEL=
# Optional: the hard ceiling on output tokens per request. Defaults to 65536,
# which is what gemini-3.6-flash accepts. Reasoning tokens are spent from this
# same budget, so it has to cover the thinking as well as the answer. Set this
# only when GEMINI_MODEL points at a model that accepts less; an unusable value
# is ignored rather than allowed to break every request, and if the API rejects
# the limit it names its own, which is then used.
GEMINI_MAX_OUTPUT_TOKENS=
# Optional: 'low' or 'high', for every request that does not name its own.
# The study and devotional functions already ask for 'low' per request, so this
# only affects life-situation guidance. Anything else is ignored, and a value
# the model refuses is dropped rather than failing the request.
GEMINI_THINKING_LEVEL=
# Optional: set to anything to log one safe line per request — model, limit,
# finish reason and token counts. No keys, no prompts, no reader text.
GEMINI_LOG_USAGE=

# Optional: daily generation allowances, counted in Postgres. These cap new AI
# content only — a cached explanation or devotional is served without being
# charged. Defaults are study 20/50, devotional 5/15, situation 2/5
# (guest/signed-in). A value that is not a whole number falls back to the
# default rather than leaving an endpoint uncapped. Zero switches an endpoint
# off for that kind of caller.
AI_DAILY_LIMIT_STUDY_GUEST=
AI_DAILY_LIMIT_STUDY_USER=
AI_DAILY_LIMIT_DEVOTIONAL_GUEST=
AI_DAILY_LIMIT_DEVOTIONAL_USER=
AI_DAILY_LIMIT_SITUATION_GUEST=
AI_DAILY_LIMIT_SITUATION_USER=

# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected into Edge Functions by Supabase automatically. You do not set them
# here, and `supabase secrets set` rejects the reserved SUPABASE_ prefix. The
# service role key is used only inside a function, to write the shared study
# cache — it must never reach the browser.

# --- Optional licensed Scripture providers ---------------------------------
# Without these the app serves its bundled public-domain translations
# (KJV, ASV, YLT, BSB). Adding credentials unlocks the copyrighted
# translations that the provider is licensed to serve.

# API.Bible (https://scripture.api.bible) — unlocks translations your key is
# authorised for, e.g. NASB/CSB/AMP depending on your agreement.
API_BIBLE_KEY=

# Crossway ESV API (https://api.esv.org) — unlocks ESV.
ESV_API_KEY=

# ---------------------------------------------------------------------------
# Daily verse email and the scheduled jobs (Supabase secrets only — none of
# these has a VITE_ counterpart, and none of them reaches the browser bundle).
# ---------------------------------------------------------------------------
# Resend API key. Sends the confirmation email and the daily verse.
RESEND_API_KEY=
# The verified sender on your Resend domain.
EMAIL_FROM=Bible Verses Understood <verse@your-domain.com>
# Signs the unsubscribe links. Any long random string; changing it invalidates
# every unsubscribe link already in an inbox, so change it only if it leaks.
EMAIL_TOKEN_SECRET=
# Shared by the two scheduled functions, prewarm and daily-email. Without it
# neither can be triggered by anybody.
CRON_SECRET=
# The public site, used for links in email and to read the bundled Scripture.
SITE_URL=https://bible-verses-understood.vercel.app
# Optional: where the Edge Functions are publicly reachable. Defaults to
# ${SITE_URL}/functions/v1; set it to your Supabase functions URL if the site
# does not proxy them.
FUNCTIONS_PUBLIC_URL=
# Optional: the translation used in email. Public domain only — KJV, BSB, ASV
# or YLT — because a licence to display a translation on a website is not a
# licence to redistribute it by email. Anything else is refused and KJV used.
EMAIL_TRANSLATION=
# Optional: a short list of passages to warm each morning alongside the Verse
# of the Day, e.g. "John 3:16, Romans 8:28". Capped regardless.
PREWARM_REFERENCES=
# Optional: which translations to warm. Public domain only. Defaults to KJV.
PREWARM_TRANSLATIONS=
